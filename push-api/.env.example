PORT=8080
NODE_ENV=production
APP_ORIGIN=https://your-pickbook-domain.com

# Supabase project URL and service role key. Keep the service role key server-only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# SUPABASE_KEY is also accepted as an alias for SUPABASE_SERVICE_ROLE_KEY.

# Optional if your Railway app also needs direct Postgres elsewhere.
DATABASE_URL=postgresql://...

# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=replace-with-public-key
VAPID_PRIVATE_KEY=replace-with-private-key
VAPID_SUBJECT=mailto:admin@pickbook.example

# Protect server-side notification trigger endpoints.
PUSH_ADMIN_TOKEN=replace-with-long-random-secret
